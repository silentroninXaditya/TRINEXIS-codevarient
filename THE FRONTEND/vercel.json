{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/discovery.html",
      "destination": "/discovery.html"
    },
    {
      "source": "/vault.html",
      "destination": "/vault.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}